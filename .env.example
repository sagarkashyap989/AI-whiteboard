# Google Gemini (preferred) — server-only, never prefix with VITE_
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id (lowercase), e.g. gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# Optional fallback: xAI Grok (used only if GEMINI_API_KEY is unset)
# GROKE_API_KEY=
# GROK_MODEL=grok-3-latest
